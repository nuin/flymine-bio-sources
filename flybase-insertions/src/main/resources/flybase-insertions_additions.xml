<?xml version="1.0"?>
<!--
  Schema additions for flybase-insertions.

  TransposableElementInsertionSite already exists in the merged genomic model
  (declared in flymine-bio-sources/flymine-global_additions.xml as
  extends="SequenceFeature"). InterMine merges multi-additions XML
  declarations of the same class, so re-declaring it here without `extends`
  is the documented way to add fields without disturbing the existing
  inheritance chain.

  Added 2026-06-04: cytogeneticLocation attribute. The FB2026_01 insertion
  mapping file carries both an estimated and an observed cytological band
  for each FBti; we surface the observed value (col 7) on the entity for
  FlyBase-parity report pages. The molecular `chromosomeLocation` reference
  populates from the precise genomic coordinates (col 3).
-->
<classes>

  <class name="TransposableElementInsertionSite" is-interface="true">
    <attribute name="cytogeneticLocation" type="java.lang.String"/>
  </class>

</classes>
