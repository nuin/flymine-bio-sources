<?xml version="1.0"?>
<!--
  Schema additions for flybase-allele-descriptions (v1).

  Replacement for the historical flybase-alleles source which failed on the
  FB2026_01 21-column dmel_classical_and_insertion_allele_descriptions_*.tsv
  format. Lean: loads only description text + supporting publication FBrf
  refs that chado-db's FlyBaseProcessor doesn't carry. Allele items already
  exist in the merged DB from chado-db-flybase-dmel (233K Allele rows in the
  2026-06-03 Phase 1.5 build); this source enriches them by FBal merge.

  Phase 2 v2 will add: insertion details (FBti), alleleClass FBcv multi-values,
  encoded product/tool, tagged-with, "also carries" allele-on-allele relation.
  Out of scope for v1.

  See HANDOFF_TO_BUILDER_PHASE1_5_2026-06-03.md §2.2 (chado already loads
  Allele core) + builder Phase 2 plan §3.1 row 2 (this new lean source path).
-->
<classes>

  <class name="Allele" is-interface="true">
    <attribute name="description" type="java.lang.String"/>
    <collection name="descriptionReferences" referenced-type="Publication"/>
  </class>

</classes>
